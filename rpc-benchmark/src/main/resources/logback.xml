<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 
        JMH Benchmark Logging Configuration
        Set root level to ERROR to minimize performance impact during benchmarks.
    -->
    <root level="ERROR">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </root>
</configuration>
